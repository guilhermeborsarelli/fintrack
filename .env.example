# Somente no servidor. Nunca use prefixo VITE_ para credenciais.
RESEARCH_SEARCH_KEY=
# Opcional: análise contextual dos trechos encontrados. Sem essa chave, usa evidências por atividade.
RESEARCH_AI_KEY=
# Login HTTP: usuário fintrack; senha definida abaixo (obrigatória em produção).
RESEARCH_PASSWORD=
HOST=127.0.0.1
PORT=8787
# Apenas se houver frontend em origem diferente. Não use wildcard com credenciais.
RESEARCH_ALLOWED_ORIGINS=
# Limite local de consultas ao provedor por hora, além do cache.
RESEARCH_MAX_HOURLY=60
